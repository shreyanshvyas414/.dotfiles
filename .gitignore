# OS Files
.DS_Store

# Neovim
nvim/lazy-lock.json
nvim/.netrwhist

# Zsh
zsh/.zcompdump*
zsh/.zsh_history

# Secrets (NEVER commit these!)
**/secrets.zsh
**/.env

# Backups
*.backup

# Fish generated state (universal vars; paths are set in conf.d/00_path.fish)
fish/fish_variables

# Yazi packages installed via `ya pkg` - reinstallable from package.toml.
# vague.yazi is hand-made (see theme.toml), so it is tracked.
yazi/flavors/*
!yazi/flavors/vague.yazi/

# Ghostty cursor shaders - third-party (MIT), cloned by setup.sh.
# Un-ignore if you start tuning the CONFIGURATION consts inside them.
ghostty/shaders/
